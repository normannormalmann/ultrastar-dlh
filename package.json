{
  "name": "ultrastar",
  "description": "Download songs from UltraStar biggest database",
  "author": "Norman Schönherr",
  "version": "1.3.0",
  "type": "module",
  "private": true,
  "main": "out/main/index.js",
  "keywords": [
    "ultrastar",
    "cli",
    "download",
    "songs"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/normannormalmann/ultrastar-dlh"
  },
  "license": "MIT",
  "homepage": "https://github.com/normannormalmann/ultrastar-dlh",
  "trustedDependencies": [
    "electron"
  ],
  "scripts": {
    "build": "bun run --cwd src build.ts",
    "start": "bun run src/index.tsx",
    "test": "bun test src",
    "test:py": "cd python-sidecar && python -m pytest tests/ -v",
    "test:py:slow": "cd python-sidecar && python -m pytest tests/ -v -m slow",
    "desktop:dev": "electron-vite dev",
    "desktop:build": "electron-vite build",
    "desktop:dist": "electron-vite build && electron-builder",
    "desktop:dist:win": "electron-vite build && electron-builder --win",
    "desktop:dist:linux": "electron-vite build && electron-builder --linux",
    "test:e2e": "electron-vite build && playwright test",
    "format": "biome format --write .",
    "clean": "git clean -xdf .turbo build",
    "lint": "biome lint --write .",
    "bump": "bumpp"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@playwright/test": "^1.62.1",
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "bumpp": "^10.4.1",
    "chalk": "^5.6.2",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "extract-zip": "^2.0.1",
    "pretty-bytes": "^7.1.1",
    "react-devtools-core": "^6.1.5",
    "tinyglobby": "^0.2.17"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "effect": "^3.22.1",
    "electron-updater": "^6.8.9",
    "env-paths": "^3.0.0",
    "ink": "^6.8.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "lucide-react": "^1.34.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "vite": "^8.0.0",
    "fast-uri": "^3.1.6",
    "postcss": "^8.5.23",
    "nanoid": "^3.3.18",
    "js-yaml": "^4.3.2",
    "undici": "^7.29.0",
    "tar": "^7.5.22"
  }
}
